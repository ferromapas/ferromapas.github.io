---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${SITE.name}, inicio`}>
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
      <path d="M4 26 L14 16 L14 6" class="wm-a" />
      <path d="M14 16 L28 16" class="wm-b" />
      <circle cx="14" cy="16" r="4.5" class="wm-node" />
    </svg>
    <span>Ferromapas</span>
  </a>
  <nav aria-label="Principal">
    <ol class="line-nav">
      {NAV.map((item) => (
        <li style={`--c: ${item.color}`}>
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            <span class="stop" aria-hidden="true"></span>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>
